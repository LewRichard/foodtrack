# Required: your Anthropic API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Optional: port for the server (default 8787)
PORT=8787

# Who can scan (once the server is online, use at least one of these):
#  - REQUIRE_SIGN_IN=true: only signed-in users (needs the Supabase settings below). No code needed.
#  - APP_ACCESS_CODE: a shared code that unlocks scanning without an account.
# With neither set, anyone who can reach the server can scan.
REQUIRE_SIGN_IN=
APP_ACCESS_CODE=

# Model for photo and text logging (empty = claude-opus-5-5), e.g. claude-haiku-5-5. See docs/AI_MODELS.md.
SCAN_MODEL=

# Scan limits, to cap what the API can cost you (0 = no limit)
SCANS_PER_IP_PER_HOUR=30
DAILY_SCAN_LIMIT=300

# Optional: accounts & cloud backup with Supabase (see docs/DATABASE.md).
# From your Supabase project: Project Settings → API (Project URL, and the anon / publishable key).
# These are public values that ship inside the app; never put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: meal reminders by push notification (see docs/REMINDERS.md). Server-only secrets.
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
